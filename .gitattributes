# Line endings are pinned repo-wide so a file's bytes are the same on every
# checkout, on every platform.
#
# This is not cosmetic. legal/<slug>/<version>/meta.yml carries a SHA-256 of
# the exact bytes of its en.md, and a consent record is meant to be provable
# by rehashing that file years later. Without this line Git's autocrlf can
# rewrite \n to \r\n on a Windows checkout, so the identical commit hashes
# differently depending on who cloned it — and a hash nobody can reproduce is
# worse than no hash at all.
#
# Binary files are excluded below so they are never touched.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.gz binary
*.wasm binary

# Doc 04B V4.3 scoring v1.0 evidence packet (E4). Its SHA-256 (29c3e0fd…) is
# attested in scoring_model_versions.validation_packet_sha256 and covers the
# EXACT bytes, including the CRLF line endings Python's csv module writes.
# -text stores them verbatim; `eol=lf` normalisation would change the hash.
# scripts/ci/scoring-evidence-packet-check.sh recomputes it on every CI run.
scripts/ci/fixtures/scoring-v1.0/** -text
