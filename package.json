{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx --env-file=.env.local server/index.ts",
    "dev:server": "cross-env NODE_ENV=development tsx --env-file=.env.local server/index.ts",
    "dev:client": "vite",
    "dev:all": "concurrently -n server,client -c blue,green \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "prebuild": "rimraf dist client/dist",
    "generate:legal-registry": "node scripts/build/generate-legal-registry.mjs",
    "generate:event-registry": "node scripts/build/generate-event-registry.mjs",
    "gate:legal-registry": "node scripts/ci/legal-registry-bundle-gate.mjs",
    "build": "pnpm -s run generate:legal-registry && pnpm -s run generate:event-registry && vite build && pnpm -s run build:prerender && pnpm -s exec esbuild server/index.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/index.js",
    "build:prerender": "vite build --ssr src/prerender/entry-server.tsx && node scripts/build/prerender.mjs",
    "build:vercel": "pnpm -s run build && pnpm -s exec esbuild server/index.ts --bundle --platform=node --format=cjs --external:@google-cloud/bigquery --minify --keep-names --metafile=dist/vercel-api.meta.json --outfile=dist/vercel-api.cjs",
    "postbuild": "node scripts/check-no-cdn-katex.js && node scripts/check-no-secrets-in-bundle.js",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "typecheck": "pnpm run check",
    "lint": "eslint .",
    "lint:shared": "eslint packages/shared",
    "deadcode": "pnpm dlx knip@5.88.1 --config knip.json --no-progress --reporter compact",
    "deadcode:student": "node scripts/ci/deadcode-student.mjs",
    "deadcode:production": "pnpm dlx knip@5.88.1 --config knip.json --no-progress --reporter compact --production --include files,exports,types",
    "lint:no-console": "eslint -c eslint.no-console.config.mjs --max-warnings 0 client/src",
    "check:shared": "tsc -p packages/shared/tsconfig.json",
    "test:shared": "vitest run packages/shared",
    "test": "vitest run",
    "test:ci": "vitest run tests/ci",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:api": "vitest run apps/api/test",
    "test:watch": "vitest",
    "test:all": "vitest run",
    "smoke:auth": "node scripts/smoke/prod-auth-smoke.mjs",
    "cleanup:stems": "tsx server/scripts/cleanup-question-stems.ts",
    "backfill:metadata": "tsx server/scripts/backfill-question-metadata.ts",
    "test:security": "vitest run tests/idor.regression.test.ts tests/entitlements.regression.test.ts",
    "generate:vercel-routes": "tsx scripts/build/generate-vercel-routes.ts",
    "build:counsel-pdf": "node scripts/compliance/build-counsel-pdf.mjs",
    "gate:seo-output": "tsx scripts/ci/seo-output-gate.ts",
    "gate:event-registry-parity": "tsx scripts/ci/event-schema-registry-parity.ts",
    "gate:pii-redaction": "tsx scripts/ci/pii-redaction-conformance.ts",
    "route:validate": "tsx scripts/validate-route-registry.mjs",
    "probe:boot": "node scripts/ci/boot-probe.mjs",
    "probe:boot:selftest": "bash scripts/ci/boot-probe.selftest.sh",
    "gate:legal": "node scripts/ci/legal-immutability-gate.mjs && node scripts/ci/legal-manifest-gate.mjs && node scripts/ci/legal-xref-gate.mjs && node scripts/ci/legal-body-purity-gate.mjs",
    "gate:legal:selftest": "bash scripts/ci/legal-gates.selftest.sh",
    "tutor:schema:proof": "tsx scripts/tutor-schema-proof.ts",
    "tutor:schema:assert": "tsx scripts/tutor-schema-proof.ts --assert-only",
    "audit:ci": "pnpm audit --json > audit-output.json || test -s audit-output.json",
    "verify:csrf": "pnpm exec tsx scripts/verify-csrf-protection.ts",
    "assemble-batch": "tsx scripts/assemble-batch.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@google/genai": "^1.50.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.104.1",
    "@tanstack/react-query": "^5.100.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "csrf-csrf": "^4.0.3",
    "express": "^4.22.1",
    "express-rate-limit": "^8.4.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "katex": "^0.16.45",
    "lucide-react": "^0.453.0",
    "posthog-js": "^1.435.9",
    "posthog-node": "^5.55.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-markdown": "9.0.1",
    "react-resizable-panels": "^2.1.9",
    "remark-gfm": "4.0.0",
    "stripe": "^20.4.1",
    "tailwind-merge": "^2.6.1",
    "uuid": "^14.0.0",
    "wouter": "^3.9.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.12.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.4.1",
    "jsdom": "^27.4.0",
    "pg": "^8.20.0",
    "postcss": "^8.5.23",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^7.3.5",
    "vitest": "^4.1.5"
  },
  "optionalDependencies": {
    "bufferutil": "^4.1.0"
  }
}
