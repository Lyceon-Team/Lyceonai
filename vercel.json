{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": "dist/public",
  "crons": [
    {
      "path": "/api/internal/legal-acceptance-drain",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/internal/execute-deletions",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/internal/stale-session-sweep",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/internal/baseline-pending-sweep",
      "schedule": "0 * * * *"
    }
  ],
  "routes": [
    {
      "src": "^/api(?:/.*)?$",
      "dest": "/api/index"
    },
    {
      "src": "^/auth/callback$",
      "dest": "/api/index"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(?!api/).*",
      "dest": "/index.html"
    }
  ]
}
